# ---------------------------------------------------------------------------
# Igbo Wikimedians — environment variables
# Set these as real environment variables (e.g. in the hosting dashboard).
# A local `.env` file is supported for development only and is gitignored.
# All are optional except DATABASE_URL. OAuth credentials are optional (the
# buttons appear only when set).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Drizzle ORM + node-postgres).
# Render internal example (use this inside Render):
#   postgresql://iwug:PASSWORD@dpg-xxxx-a/dbname
# Render external example (for local tools):
#   postgresql://iwug:PASSWORD@dpg-xxxx-a.oregon-postgres.render.com/dbname
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/igbo_wikimedians

# Connection pool size (optional, defaults to 10).
DB_POOL_SIZE=10

# TLS override for the database connection. Leave empty to auto-detect:
# Render internal hosts (single-label) and localhost connect without TLS, all
# other hosts use TLS. Set to `require` or `disable` to force it.
DB_SSL=
# Alternative to appending ?sslmode=... to DATABASE_URL.
DB_SSL_MODE=

# Redis connection string for the read cache. Leave empty to run cache-less
# (the site still works; reads just hit PostgreSQL every time).
REDIS_URL=

# HTTP port for the API server (defaults to 5000). Vite runs on 5173 in dev.
PORT=5000

# Base path the app is served under (default `/`). Set to `/path` when the app
# is hosted behind a sub-path proxy (used for building asset URLs).
BASE_PATH=/

# Comma-separated list of verified email addresses allowed to administer the CMS.
IWUG_ADMIN_EMAILS=

# Comma-separated list of Wikimedia usernames allowed to administer the CMS.
IWUG_ADMIN_WIKIMEDIA_USERNAMES=

# User-Agent sent to Wikimedia statistics APIs (Wikimedia requires a real,
# descriptive User-Agent for bots and scripts).
WIKIMEDIA_USER_AGENT=IgboWikimediansCommunitySite/1.0 (contact@example.org)

# Optional Igbo API key (https://igboapi.com). When empty, the dictionary
# falls back to the keyless Igbo Wiktionary provider.
IGBO_API_KEY=

# ---------------------------------------------------------------------------
# Self-hosted auth / OAuth. Email + Wikimedia-username registration works
# without any of these; an OAuth button appears only when its provider is set.
# ---------------------------------------------------------------------------

# Google OAuth 2.0 — credentials from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wikimedia (MediaWiki) OAuth 2.0 — consumer registered at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose
WIKIMEDIA_OAUTH_CLIENT_ID=
WIKIMEDIA_OAUTH_CLIENT_SECRET=

# Public origin where OAuth providers redirect back to (registered with each
# provider). Leave empty in dev to derive from the request host.
OAUTH_REDIRECT_ORIGIN=

# Public origin of the front-end, used for post-login redirects. Leave empty in
# dev (defaults to http://localhost:5173).
APP_ORIGIN=

# CORS origin(s) allowed in development (comma-separated). In production the
# app serves the API and frontend from the same origin.
# CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Paystack (memberships + donations). Leave the secret key empty to disable
# online payments; the donation page then falls back to the configured
# destination URL from site settings. Keys: https://dashboard.paystack.com/#/settings/developers
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=